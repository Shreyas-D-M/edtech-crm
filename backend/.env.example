# Server Configuration
PORT=5001
NODE_ENV=development

# Database Configuration (Supabase PostgreSQL Connection String)
# Format: postgresql://postgres:[YOUR-PASSWORD]@[YOUR-SUPABASE-DB-HOST]:5432/postgres
# Direct connection (Session mode) or Transaction pooler (Port 6543)
DATABASE_URL=postgresql://postgres.yourprojectid:yourpassword@aws-0-region.pooler.supabase.com:6543/postgres

# Security & Authentication
# Generate a secure 64+ char random string for production
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_random
JWT_EXPIRES_IN=24h

# Frontend Client URL (for CORS and Cookie SameSite validation)
FRONTEND_URL=http://localhost:5173

# Initial Admin Credentials (used by scripts/create-admin.js if CLI args not passed)
ADMIN_NAME=System Administrator
ADMIN_EMAIL=admin@edtech.com
ADMIN_PASSWORD=AdminSecurePassword123!
